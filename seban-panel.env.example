# Copy this file to seban-panel.env. Do not commit the copied file.
DB_HOST=metin2-db
DB_PORT=3306
DB_USER=player
DB_PASSWORD=replace-with-your-database-password
PLAYERBOTS_NETWORK=playerbots_backend
PLAYERBOTS_GAME_VAR_VOLUME=metin2_game-var
PLAYERBOTS_RATES_SPOOL_VOLUME=metin2_rates-spool
# Shared with Tieru's isolated updater. The web panel never mounts Docker's socket.
PLAYERBOTS_UPDATE_SPOOL_VOLUME=metin2_update-spool
PLAYERBOTS_GAME_HOST=metin2-game
PLAYERBOTS_LOGIN_PORT=11000
PLAYERBOTS_WORLD_PORT=13000
# Wersja zainstalowanego wydania Tieru, widoczna na Dashboardzie.
PLAYERBOTS_VERSION=1.30.12
# Path inside PLAYERBOTS_GAME_VAR_VOLUME that contains playerbot_status.tsv.
PLAYERBOTS_STATUS_GLOB=/opt/metin2/var/channel1/*/playerbot_status.tsv
SEBAN_SESSION_SECRET=replace-with-a-long-random-value
# This address is opened by the visitor's browser. Use the server's reachable
# address, not 127.0.0.1, when the classic panel runs on another machine.
TIERU_PANEL_URL=http://your-server-address:7788
SEBAN_COLLECTOR_INTERVAL=300
